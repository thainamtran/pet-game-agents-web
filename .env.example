# Copy this file to .env and fill in values as needed.
# Never commit a real .env or API key.

PORT=3100

# "auto" uses an LLM if OPENAI_API_KEY is set, otherwise mock mode.
# "mock" is fully offline and deterministic (no network, no key).
# "llm" requires a key and talks to an OpenAI-compatible API.
LLM_MODE=auto

# Required only for LLM mode (OpenAI or a compatible provider).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PET_GAME_SPECIES=cat
PET_GAME_THEME=cozy backyard companion
PET_GAME_AUTO_APPROVE=false
PET_GAME_MAX_RETRIES=3
PET_GAME_OUTPUT_DIR=output
